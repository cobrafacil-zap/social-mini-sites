# ------------------------------------------------------------------
# Ambiente local (copie para .env.local — NÃO versionar)
# ------------------------------------------------------------------

# Next.js / Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Domínio raiz do projeto (apex + wildcard)
NEXT_PUBLIC_ROOT_DOMAIN=smdigtal.com

# URL canônica exibida nos QR codes e no admin (sem path)
NEXT_PUBLIC_SITE_URL=https://www.smdigital.com

# ------------------------------------------------------------------
# Diagnóstico (scripts/diag.sh) — opcional
# ------------------------------------------------------------------

# Token pessoal: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Nome do projeto na Vercel (default: social-mini-sites)
VERCEL_PROJECT=social-mini-sites
# Slug do time (aparece na URL *.vercel.app) — o teamId é resolvido via API
VERCEL_TEAM_SLUG=equipesocialmktdigital-1894s

# Token pessoal: https://supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
